# ---------- Core ----------
APP_ENV=development
DEMO_MODE=1                       # 1 = offline fixtures, no external calls; 0 = live
PUBLIC_BASE_URL=http://localhost:8000   # must be publicly reachable for Bolna webhooks (deploy, or cloudflared/ngrok); otherwise the poller is used
DATABASE_URL=sqlite:///./smriti.db
SECRET_SALT=change-me             # salts the phone-number hash
ADMIN_REVIEW_TOKEN=change-me      # bearer token for the reviewer queue
# ---------- Bolna ----------
BOLNA_API_BASE=https://api.bolna.ai
BOLNA_API_KEY=
BOLNA_AGENT_ID=                   # printed by scripts/create_agent.py
BOLNA_AGENT_ID_KN=                # optional; Kannada agent from scripts/create_agent.py --language kn
BOLNA_AGENT_ID_EN=                # optional; English agent from scripts/create_agent.py --language en
BOLNA_AGENT_ID_CHECKIN=            # weekly check-in agent: scripts/create_agent.py --kind checkin
BOLNA_AGENT_ID_FAMILY=             # call to the family: scripts/create_agent.py --kind family
BOLNA_MULTILINGUAL=0              # 1 = BOLNA_AGENT_ID was made with --multilingual: the person picks Hindi, Kannada or English
BOLNA_FROM_NUMBER=                # optional; empty = Bolna default number
BOLNA_WEBHOOK_TOKEN=change-me     # appended as ?token= to the webhook URL and checked
# ---------- Optional ASR fallback (fluency timing) ----------
ASR_PROVIDER=none                 # none | sarvam | deepgram
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
# ---------- Safety limits for the hosted demo ----------
MAX_CALLS_PER_IP_PER_DAY=3
MAX_CALL_MINUTES=8
HELPLINE_TEXT=                    # helpline shown on reports; fill only with a verified number

# Demo: three apps on three ports from one process (scripts/run_demo.py)
FAMILY_PORT=8000
ELDER_PORT=8001
CLINIC_PORT=8002
SCHEDULER_ENABLED=0               # 1 = run scheduled check-ins automatically (demo mode only)
